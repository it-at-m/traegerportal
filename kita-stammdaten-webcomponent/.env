VITE_BASE_API_PATH="/api/backend"

# Enable automatic login for local development to bypass the login button
VITE_KEYCLOAK_AUTOLOGIN=true
# Keycloak settings used for automatic login
VITE_KEYCLOAK_TOKEN_URL=http://keycloak:8100/auth/realms/local_realm/protocol/openid-connect/token
VITE_KEYCLOAK_CLIENT_ID=local
VITE_KEYCLOAK_CLIENT_SECRET=client_secret
VITE_KEYCLOAK_USERNAME=writer
VITE_KEYCLOAK_PASSWORD=writer
VITE_KEYCLOAK_SCOPE=profile local_audience email openid
# AuthorizationEventDetails used for automatic login
VITE_AUTOLOGIN_BUERGERNAME=Vorname Nachname
VITE_AUTOLOGIN_BUERGERMAIL=vorname.nachname@muenchen.test
VITE_AUTOLOGIN_LOGINPROVIDER=example
VITE_AUTOLOGIN_TRUSTLEVEL=KEYCLOAK_AUTH_LEVEL4
